      "jsonLd": [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "How do I book a consultation?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Use the booking form on this website or tap the WhatsApp button. Share your name, service needed and preferred date — we will confirm your slot on WhatsApp."
              }
            },
            {
              "@type": "Question",
              "name": "Which documents do I need?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "For salaried individuals: Form 16, interest certificates, investment proofs (80C, 80D etc.) and Aadhaar/PAN. For businesses: books of account, bank statements, sales & purchase details. We will give you a checklist specific to your case."
              }
            },
            {
              "@type": "Question",
              "name": "What are your fees?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Fees depend on the complexity of the work — a simple salary return costs much less than a business audit. You will always be told the exact fee upfront before we begin. Please contact us for a quote.\nThe first consultation is free."
              }
            },
            {
              "@type": "Question",
              "name": "Can consultations happen online?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. While we welcome you at our office, most routine matters (ITR filing, GST returns, documents) can be handled completely over WhatsApp, email or phone."
              }
            },
            {
              "@type": "Question",
              "name": "I got a tax notice. What now?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Don't panic, and don't ignore it. Bring or send us the notice as soon as possible — we will read it, explain what it means in plain language, and prepare a proper response within the deadline."
              }
            },
            {
              "@type": "Question",
              "name": "Do you handle GST registration?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes — registration, amendments, monthly/quarterly returns and annual reconciliation. We also advise on whether GST registration is required for your turnover and business type."
              }
            },
            {
              "@type": "Question",
              "name": "Is my information confidential?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Absolutely. Professional confidentiality is a cornerstone of our practice. Your documents and data are never shared with any third party."
              }
            }
          ]
        }
      ],
