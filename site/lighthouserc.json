{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- -p 3200",
      "startServerReadyPattern": "Ready|started|listening",
      "numberOfRuns": 1,
      "url": [
        "http://localhost:3200/",
        "http://localhost:3200/about",
        "http://localhost:3200/services",
        "http://localhost:3200/why-choose-us",
        "http://localhost:3200/testimonials",
        "http://localhost:3200/faq",
        "http://localhost:3200/contact",
        "http://localhost:3200/book"
      ]
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": "warn",
        "categories:seo": "warn",
        "categories:performance": "warn"
      }
    }
  }
}
